-- This script will create a draggable UI with buttons to modify Butter, Milkshakes, and Chocolate values

local player = game.Players.LocalPlayer  -- Reference to the player running the script

-- Ensure the leaderstats folder and the values exist
local function setupLeaderstats()
    -- Wait for leaderstats to exist and set up Butter, Milkshakes, and Chocolate
    local leaderstats = player:WaitForChild("leaderstats", 10)
    if not leaderstats then
        -- Create leaderstats folder if it doesn't exist
        leaderstats = Instance.new("Folder")
        leaderstats.Name = "leaderstats"
        leaderstats.Parent = player
    end
    
    -- Create Butter, Milkshakes, and Chocolate if they don't exist
    local butter = leaderstats:FindFirstChild("Butter")
    if not butter then
        butter = Instance.new("NumberValue")
        butter.Name = "Butter"
        butter.Value = 0  -- Initial value
        butter.Parent = leaderstats
    end
    
    local milkshakes = leaderstats:FindFirstChild("Milkshakes")
    if not milkshakes then
        milkshakes = Instance.new("NumberValue")
        milkshakes.Name = "Milkshakes"
        milkshakes.Value = 0  -- Initial value
        milkshakes.Parent = leaderstats
    end

    local chocolate = leaderstats:FindFirstChild("Chocolate")
    if not chocolate then
        chocolate = Instance.new("NumberValue")
        chocolate.Name = "Chocolate"
        chocolate.Value = 0  -- Initial value
        chocolate.Parent = leaderstats
    end
end

-- Set up leaderstats and values
setupLeaderstats()

