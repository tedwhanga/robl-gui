-- Draggable functionality for the whole frame
local dragging = false
local dragInput, mousePos, objPos

-- Start dragging
local function onDragStart(input)
    dragging = true
    dragInput = input
    mousePos = input.Position
    objPos = background.Position
end

-- Drag movement
local function onDragMove(input)
    if dragging then
        local delta = input.Position - mousePos
        background.Position = UDim2.new(objPos.X.Scale, objPos.X.Offset + delta.X, objPos.Y.Scale, objPos.Y.Offset + delta.Y)
    end
end

-- Stop dragging
local function onDragEnd(input)
    dragging = false
end

-- Connect drag events to the screen GUI
background.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        onDragStart(input)
    end
end)

background.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        onDragMove(input)
    end
end)

background.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        onDragEnd(input)
    end
end)

-- Function to modify Butter value (add 1 to Butter)
local function modifyButter()
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        local butter = leaderstats:FindFirstChild("Butter")
        if butter then
            butter.Value = butter.Value + 99999999999999999999999999999999999999999999999999999999999999999999  -- Add 1 to Butter
            print(player.Name .. "'s new Butter value: " .. butter.Value)
        else
            warn("Butter value not found!")
        end
    else
        warn("leaderstats folder not found!")
    end
end

