-- Draggable functionality
local dragging = false
local dragInput, dragStart, startPos

-- Function to start dragging
titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
    end
end)

-- Function to stop dragging
titleBar.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

-- Update the position while dragging
game:GetService("UserInputService").InputChanged:Connect(function(input)
    if dragging then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- Function to move currency parts to the player's feet
local function moveCurrencyParts(currencyName)
    local rootPart = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not rootPart then
        print("ERROR: HumanoidRootPart not found!")
        return
    end

    local footPosition = rootPart.Position - Vector3.new(0, 2, 0)
    local cheesePosition = rootPart.Position - Vector3.new(0, 3, 0)

    -- Move currency parts to the player's feet
    local partsFound = false
    for _, obj in pairs(workspace:WaitForChild("Heads"):GetChildren()) do
        if obj:IsA("BasePart") and obj.Name == currencyName then
            partsFound = true
            local targetPosition = (currencyName == "Cheese") and cheesePosition or footPosition
            obj.CFrame = CFrame.new(targetPosition)
            print(currencyName .. " part moved to player's feet: " .. obj:GetFullName())
        end
    end

    -- If no parts were found for the currency
    if not partsFound then
        print("No " .. currencyName .. " parts found in the workspace!")
    end
end

-- Create and align buttons centrally inside the black background
local milkButton, cheeseButton

local function createCurrencyButton(currencyName)
    local button = Instance.new("TextButton")
    button.Parent = frame
    button.Text = "Enable " .. currencyName .. " Magnet"
    button.BackgroundColor3 = Color3.fromRGB(77, 0, 153)  -- Purple color
    button.TextColor3 = Color3.fromRGB(255, 255, 255)  -- White text
    button.Font = Enum.Font.GothamBold
    button.TextSize = 20  -- Matching the text size from the main script
    button.ZIndex = 3

    -- Set button size and center it
    button.Size = UDim2.new(0, 300, 0, 40)  -- Static size for simplicity
    button.Position = UDim2.new(0.5, -150, 0, -70 + (60 * (#frame:GetChildren() - 2)))  -- Adjusting vertical spacing for better alignment

    -- UICorner for rounded corners of the button
    local buttonCorner = Instance.new("UICorner")
    buttonCorner.CornerRadius = UDim.new(0, 12)
    buttonCorner.Parent = button

    local magnetEnabled = false

    -- Function to enable the magnet for this currency
    local function enableMagnet()
        if magnetEnabled then return end
        magnetEnabled = true
        button.Text = "Disable " .. currencyName .. " Magnet"
        button.BackgroundColor3 = Color3.fromRGB(0, 175, 0)  -- Change color to green when enabled
        print(currencyName .. " Magnet enabled, moving " .. currencyName .. " parts to the player's feet.")

        -- Continuously move the parts using Heartbeat event
        game:GetService("RunService").Heartbeat:Connect(function()
            if magnetEnabled then
                moveCurrencyParts(currencyName)
            end
        end)
    end

    -- Function to disable the magnet
    local function disableMagnet()
        magnetEnabled = false
        button.Text = "Enable " .. currencyName .. " Magnet"
        button.BackgroundColor3 = Color3.fromRGB(77, 0, 153)  -- Reset color to purple
        print(currencyName .. " Magnet Disabled.")
    end

    -- Toggle the magnet on/off when the button is clicked
    button.MouseButton1Click:Connect(function()
        if magnetEnabled then
            disableMagnet()
        else
            enableMagnet()
        end
    end)

    return button  -- Return button to manage later
end

-- Minimize functionality
local minimized = false
local originalSize = frame.Size

local function toggleMinimize()
    minimized = not minimized
    frame.Size = minimized and UDim2.new(0, 320, 0, 40) or originalSize

    -- Toggle visibility of Milk and Cheese buttons
    milkButton.Visible = not minimized
    cheeseButton.Visible = not minimized
end

minimizeButton.MouseButton1Click:Connect(toggleMinimize)
closeButton.MouseButton1Click:Connect(function()
    frame.Visible = false
end)

-- Create the buttons, only Milk and Cheese now, and store them
milkButton = createCurrencyButton("Milk")
cheeseButton = createCurrencyButton("Cheese")

-- Initially hide the buttons when minimized
milkButton.Visible = true
cheeseButton.Visible = true
